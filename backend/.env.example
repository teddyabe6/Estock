# Copy to backend/.env for local development. Never commit real secrets.

ENVIRONMENT=development
DEBUG=true

# PostgreSQL is the production database; Docker Compose provides it locally.
DATABASE_URL=postgresql+psycopg://estock:estock@localhost:5432/estock

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-before-any-deployment
ACCESS_TOKEN_TTL_MINUTES=720

REDIS_URL=redis://localhost:6379/0

# Trial length in days; platform admins can change it per business at runtime.
DEFAULT_TRIAL_DAYS=14

# File storage: "local" writes to disk. An S3-compatible backend can be added
# behind the same interface without touching the rest of the code.
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./var/uploads
MAX_UPLOAD_BYTES=10485760

DEFAULT_CURRENCY=ETB
DEFAULT_LOCALE=en

# Where the web app is served; used for share links and CORS.
PUBLIC_BASE_URL=http://localhost:3000

# Browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
